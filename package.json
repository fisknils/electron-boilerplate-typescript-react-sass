{
  "name": "electron-boilerplate-typescript-react-sass",
  "version": "1.0.0",
  "description": "An Electron boilerplate using TypeScript, React and Sass",
  "scripts": {
    "dev": "node scripts/dev.js",
    "typecheck": "tsc --noEmit",
    "prod": "npm run typecheck && rimraf dist && webpack --mode production",
    "start": "electron .",
    "dist": "npm run prod && electron-builder --config electron-builder.json",
    "dist:dir": "npm run dist -- --dir -c.compression=store -c.mac.identity=null"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chuzzy/electron-react-typescript.git"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "babel",
    "webpack",
    "sass"
  ],
  "author": "Chuzzy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Chuzzy/electron-react-typescript/issues"
  },
  "main": "dist/main/index.js",
  "homepage": "https://github.com/Chuzzy/electron-react-typescript#readme",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack-env": "^1.18.8",
    "css-loader": "^7.1.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.6.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "sass": "^1.107.0",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "source-map-support": "^0.5.19"
  }
}
