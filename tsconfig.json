{
  "compileOnSave": false,
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react",
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["webpack-env"],
    "isolatedModules": true,
    "noEmit": true,
    "pretty": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noImplicitAny": true
  },
  "exclude": ["node_modules", "dist"]
}
